<Window x:Class="CaCuSibAutoPlan.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CaCuSibAutoPlan.Converters"
        Title="CaCU SIB AutoPlan"
        Width="980"
        Height="700"
        MinWidth="900"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <conv:RadioButtonStringConverter x:Key="RadioButtonStringConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Border Margin="16"
            BorderBrush="#222222"
            BorderThickness="2"
            CornerRadius="8"
            Padding="16"
            Background="White">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="#222222"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="Departamento de Física Médica"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Liga Nacional Contra el Cáncer"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="CaCU SIB AutoPlan"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="70"
                            Height="70"
                            BorderBrush="#222222"
                            BorderThickness="1"
                            CornerRadius="35"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="0"
                            ClipToBounds="True">
                        <Image Source="incan-logo.png"
                               Stretch="Uniform" Margin="-1"/>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Plan Id:"/>
                <TextBox Grid.Column="1"
                         Text="{Binding PlanId, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Grid.Column="2"
                            Orientation="Vertical"
                            Margin="18,0,0,0">
                    <TextBlock Text="Patient information" FontWeight="SemiBold"/>
                    <TextBlock>
                        <Run Text="Name: "/>
                        <Run Text="{Binding PatientName}"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text="Id: "/>
                        <Run Text="{Binding PatientId}"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text="Selected StructureSet: "/>
                        <Run Text="{Binding StructureSetId}"/>
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="3"
                        Content="Save"
                        Command="{Binding SaveSettingsCommand}"
                        Height="34"
                        VerticalAlignment="Top" Click="Button_Click"/>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="1.45*"/>
                    <ColumnDefinition Width="0.90*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="Structures">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="PTV1:"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding Ptvs}"
                                  SelectedItem="{Binding SelectedPtv1}"
                                  DisplayMemberPath="DisplayName"/>
                        <TextBox Grid.Row="0" Grid.Column="2"
                                 Text="{Binding Ptv1DoseGyText, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="PTV2:"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding Ptvs}"
                                  SelectedItem="{Binding SelectedPtv2}"
                                  DisplayMemberPath="DisplayName"/>
                        <TextBox Grid.Row="1" Grid.Column="2"
                                 Text="{Binding Ptv2DoseGyText, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="PTV3:"/>
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  ItemsSource="{Binding PtvsWithNone}"
                                  SelectedItem="{Binding SelectedPtv3}"
                                  DisplayMemberPath="DisplayName"/>
                        <TextBox Grid.Row="2" Grid.Column="2"
                                 Text="{Binding Ptv3DoseGyText, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                   Text="Machine:"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,4"/>

                        <RadioButton Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                                     Content="HAL1102"
                                     GroupName="Machine"
                                     Margin="4"
                                     IsChecked="{Binding SelectedMachineId, Mode=TwoWay, Converter={StaticResource RadioButtonStringConverter}, ConverterParameter=HAL1102}"/>

                        <RadioButton Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                                     Content="HAL1753"
                                     GroupName="Machine"
                                     Margin="4"
                                     IsChecked="{Binding SelectedMachineId, Mode=TwoWay, Converter={StaticResource RadioButtonStringConverter}, ConverterParameter=HAL1753}"/>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Column="1" Header="Plan Prescription">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="145"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Course Id:"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding Courses}"
                                  SelectedItem="{Binding SelectedCourseId}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Prescription name:"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding Prescriptions}"
                                  SelectedItem="{Binding SelectedPrescription}"
                                  DisplayMemberPath="DisplayName"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Target Id:"/>
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  ItemsSource="{Binding PrescriptionTargets}"
                                  SelectedItem="{Binding SelectedPrescriptionTarget}"
                                  DisplayMemberPath="TargetId"/>

                        <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                  Content="Inguinals"
                                  IsChecked="{Binding HasInguinalNodes}"
                                  Margin="4"/>

                        <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                  Content="Crop PTV outside Body"
                                  IsChecked="{Binding CropPtvOutsideBody}"
                                  Margin="4"/>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Column="2" Header="All Process">
                    <StackPanel VerticalAlignment="Center">
                        <Button Content="AutoPlan"
                                Height="70"
                                FontSize="16"
                                Command="{Binding RunAutoPlanCommand}"/>
                        <TextBlock Text="Run 1 → 2 → 3 → 4"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="{Binding WorkflowProgressText}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,4"/>
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Height="22"
                                     Value="{Binding WorkflowProgressValue}"
                                     IsIndeterminate="{Binding WorkflowProgressIsIndeterminate}"/>
                        <TextBlock Text="{Binding WorkflowProgressValue, StringFormat={}{0:0}%}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <Grid Grid.Row="3" Margin="0,18,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding RunOptimizationStructuresCommand}">
                    <StackPanel>
                        <TextBlock Text="1" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Optimization Structures" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="→"
                           FontSize="34"
                           VerticalAlignment="Center"
                           Margin="12,0"/>

                <Button Grid.Column="2" Command="{Binding RunPlanParametersCommand}">
                    <StackPanel>
                        <TextBlock Text="2" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Plan Parameters" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="3"
                           Text="→"
                           FontSize="34"
                           VerticalAlignment="Center"
                           Margin="12,0"/>

                <Button Grid.Column="4" Command="{Binding RunDvhEstimationCommand}">
                    <StackPanel>
                        <TextBlock Text="3" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="DVH Estimation" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="4"
                    Background="#F1F1F1"
                    CornerRadius="4"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Height="14"
                                 Margin="0,6,0,0"
                                 Value="{Binding WorkflowProgressValue}"
                                 IsIndeterminate="{Binding WorkflowProgressIsIndeterminate}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
